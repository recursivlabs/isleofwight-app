{
  "name": "isleofwight-app",
  "version": "2.0.1",
  "main": "index.js",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "node scripts/check-web-artifact.mjs && node scripts/meta-server.mjs",
    "build": "node scripts/assert-deploy-env.mjs && pnpm packages:build && EXPO_UNSTABLE_TREE_SHAKING=0 EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=0 expo export --platform web && node scripts/inject-boot-shell.mjs && node scripts/write-build-info.mjs --optional && node scripts/check-web-artifact.mjs",
    "dev": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "access:setup": "bash scripts/bootstrap-dev-access.sh",
    "access:check": "bash scripts/dev-access-check.sh",
    "docs:check": "node scripts/check-docs-sync.mjs",
    "typecheck": "pnpm packages:build && tsc --noEmit",
    "test": "pnpm expo:check && pnpm packages:build && vitest run && node scripts/meta-server.test.mjs && node --test scripts/assert-deploy-env.test.mjs scripts/check-release-readiness.test.mjs scripts/check-web-artifact.test.mjs scripts/parity-failure-context.test.mjs scripts/write-build-info.test.mjs && pnpm test:access-helper && node scripts/verify-released-tasks.test.mjs",
    "test:access-helper": "python3 scripts/__tests__/test_infisical_secret.py",
    "test:watch": "vitest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "biome lint app components lib packages",
    "expo:check": "CI=1 expo install --check",
    "packages:build": "pnpm --filter './packages/**' run build",
    "packages:typecheck": "pnpm --filter './packages/**' run typecheck",
    "packages:test": "pnpm --filter './packages/**' run test",
    "packages:pack": "node scripts/verify-package-contents.mjs packages/sdk packages/api packages/mcp packages/cli packages/tenant-overlay",
    "packages:runtime": "node scripts/check-package-runtime.mjs",
    "packages:check": "pnpm packages:build && pnpm packages:typecheck && pnpm packages:test && pnpm packages:runtime && pnpm packages:pack",
    "eas-build-post-install": "pnpm --filter @minds/sdk build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@minds/sdk": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@recursiv/sdk": "0.7.14",
    "@sentry/react-native": "~7.13.0",
    "dompurify": "^3.4.15",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "hls.js": "^1.7.2",
    "posthog-js": "^1.428.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "^4.1.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/cli": "2.58.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.10",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-keyboard-controller"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@sentry/cli",
      "core-js",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "nanoid": ">=3.3.17 <4",
      "undici": ">=6.27.0 <7",
      "fast-uri": ">=3.1.6 <4",
      "js-yaml@3": ">=3.15.0 <4",
      "js-yaml@4": ">=4.3.1",
      "tar": ">=7.5.19",
      "form-data": ">=4.0.6",
      "shell-quote": ">=1.9.0",
      "socket.io-parser": ">=4.2.7",
      "postcss": ">=8.5.18",
      "ws@8": ">=8.21.0",
      "@xmldom/xmldom": ">=0.8.15 <0.9",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4 <3",
      "brace-expansion@5": ">=5.0.9 <6",
      "ws@6": ">=6.2.4 <7",
      "sharp": ">=0.35.0 <0.36",
      "@babel/core": ">=7.29.6 <8",
      "esbuild": ">=0.25.0 <0.26",
      "uuid": ">=11.1.1 <12",
      "vite": ">=6.4.3 <7",
      "browserslist": ">=4.28.7 <5",
      "qs": ">=6.16.0 <7"
    }
  }
}
