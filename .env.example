# The app runs with no .env at all. Every value below is optional and only
# overrides a default in lib/recursiv.ts.

# API base URL. Defaults to https://api.minds.com/api/v1 — the dedicated Minds
# instance, served by recursiv-minds-api off the dedicated Minds Neon. (The old
# shared api.minds.recursiv.io ran on the central multi-tenant DB; see the note
# in lib/recursiv.ts.) EXPO_PUBLIC_API_URL is accepted as a second fallback, and
# is the name the deployed config actually sets.
EXPO_PUBLIC_RECURSIV_API_URL=https://api.minds.com/api/v1

# Overrides for the Minds 2.0 prod project. lib/recursiv.ts hardcodes both as
# fallbacks, so leave them empty unless you are pointing at dev or staging.
EXPO_PUBLIC_RECURSIV_ORG_ID=
EXPO_PUBLIC_RECURSIV_PROJECT_ID=

# The site's own origin, sent as the Referer for Bunny video requests (Bunny
# gates on referer via "Block Direct URL Access"). On web the browser sets this
# automatically; native falls back to https://minds.on.recursiv.io.
EXPO_PUBLIC_SITE_URL=

# Enables the returning-member welcome modal and banner at one exact cutover
# instant. Use a full ISO-8601 timestamp with an offset (for example,
# 2026-08-31T04:00:00.000Z). Accounts created before this instant are eligible
# from launch through day 30. Empty or invalid values disable the campaign, so
# a build cannot announce a cutover before the launch owner sets the gate.
EXPO_PUBLIC_MINDS_2_LAUNCH_AT=

# Native crash reporting (iOS/Android only). The DSN is a public client value;
# the reporter stays disabled when it is empty or when the kill switch is
# explicitly false. SENTRY_ORG, SENTRY_PROJECT, and SENTRY_AUTH_TOKEN belong in
# the EAS build environment (never in this file) so release source maps upload.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_DEPLOY_ENV=development

# NOTE: there is deliberately no API key here. The SDK is constructed per user
# at login via createAuthedSdk(apiKey) in lib/recursiv.ts — there is no app-wide
# key. Expo inlines every EXPO_PUBLIC_* value into the client bundle at build
# time, so a real key placed here would be published to every user.
