# P4(3) — staging environment for the Minds app.
#
# Points the app at the STAGING origin, which already exists and is healthy:
#   curl -s https://api.staging.recursiv.io/api/v1/health  →  {"status":"ok",...}
#
# NOT production. lib/recursiv.ts hardcodes the production org/project as
# fallbacks, so BOTH ids below must be filled with the staging org/project or
# the app silently talks to PRODUCTION with a staging API URL — the specific
# failure P4(2)'s byte-equality check exists to catch. An empty value here is
# not "unset", it is "use production".
EXPO_PUBLIC_RECURSIV_API_URL=https://api.staging.recursiv.io/api/v1

# The staging org/project ids and dedicated QA identity are provisioned. The
# staging monitor uses STAGING_QA_EMAIL/STAGING_QA_PASSWORD and fails unless it
# can run parity plus a live org-id binding check against this origin.
# Exit artifact for (2): the org id resolving on the staging origin AND being
# byte-equal to the value written here.
EXPO_PUBLIC_RECURSIV_ORG_ID=019fd8e0-e381-728f-9565-f16dacf27b4f
EXPO_PUBLIC_RECURSIV_PROJECT_ID=019fd8e0-e4e9-703a-b259-8cbb8519d9cb

# The branded web surface is live and bound to the separate Minds staging app.
# Its DNS CNAME targets minds-staging.staging.recursiv.io; both hostnames serve
# the same staging bundle, but this branded origin is the P4 web artifact.
EXPO_PUBLIC_SITE_URL=https://staging.terrapin.minds.com
